# Copie ce fichier en ".env" et remplis tes propres valeurs.
# Ne jamais commit le fichier ".env" (il contient des secrets).

PORT=3000

# Mot de passe pour l'Espace artiste (ajout/suppression de titres).
ADMIN_PASSWORD=change-moi

# Projet Supabase (Paramètres -> API dans le tableau de bord Supabase).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La clé "service_role", PAS la clé "anon" -- elle a tous les droits, ne la mets
# jamais dans du code envoye au navigateur, uniquement ici cote serveur.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Nom du bucket de stockage cree dans Supabase (Storage -> New bucket, rendu "Public").
SUPABASE_BUCKET=organic-media

# Cle secrete Stripe (sk_test_... en test, sk_live_... en production).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
